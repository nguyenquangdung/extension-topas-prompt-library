{
    "key": "",
    "manifest_version": 3,
    "name": "Topas Prompt Library",
    "version": "1.0.0",
    "description": "Quick access to Topas Prompt Library via Side Panel.",
    "permissions": [
        "sidePanel",
        "storage",
        "identity",
        "scripting"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "side_panel": {
        "default_path": "index.html"
    },
    "action": {
        "default_title": "Open Topas Prompt Library",
        "default_icon": "favicon.png"
    },
    "icons": {
        "16": "favicon.png",
        "48": "favicon.png",
        "128": "favicon.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://yhrxfnjpgurchgzvjtqw.supabase.co https://*.supabase.co https://api.github.com; img-src 'self' https: data:;"
    },
    "host_permissions": [
        "<all_urls>"
    ]
}